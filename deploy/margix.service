# Brings Margix IMS back after a reboot.
#
# Rootless podman does not restart containers on boot by itself, and the host's
# global podman-restart.service is deliberately left disabled (enabling it
# would change the restart behaviour of the unrelated stacks running under the
# same user). This unit touches only this stack.
#
# Install (as the owning user, with lingering already enabled):
#   mkdir -p ~/.config/systemd/user
#   cp ~/apps/Margix-IMS/deploy/margix.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now margix.service

[Unit]
Description=Margix IMS (podman compose)
Wants=network-online.target
After=network-online.target
# Never stop retrying: a user unit's network-online.target is reached at once,
# so at boot this can run before the host is online.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/apps/Margix-IMS/deploy
ExecStart=/usr/bin/podman compose -f compose.prod.yml --env-file .env.production up -d
ExecStop=/usr/bin/podman compose -f compose.prod.yml --env-file .env.production stop
# The first start builds both images.
TimeoutStartSec=1800
Restart=on-failure
RestartSec=20

[Install]
WantedBy=default.target
