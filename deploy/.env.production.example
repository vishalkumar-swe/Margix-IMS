# Settings for deploy/compose.prod.yml. Copy to deploy/.env.production
# (chmod 600, never commit it) and replace every "change-me" value.
# Generate secrets with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Tailnet (the app publishes no host port; see RUNBOOK.md)
# ---------------------------------------------------------------------------

# The app answers at https://<TS_HOSTNAME>.<tailnet>.ts.net (public via Funnel)
TS_HOSTNAME=margix

# A Tailscale auth key, used once to enrol the sidecar as a device.
# Generate at https://login.tailscale.com/admin/settings/keys
# Leave blank to enrol interactively: start the stack, run
#   podman logs -f margix-ts-1
# and open the login URL it prints. The identity is kept in the
# margix_ts_state volume, so this is needed only the first time.
TS_AUTHKEY=

# First administrator, created by `podman compose ... run --rm seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
# true = also load the sample masters, opening stock and an open PO
# (acceptance testing). Demo logins are never created in production.
SEED_SAMPLE_DATA=false

# Printed on GRN and dispatch notes
COMPANY_NAME="Margix India"
COMPANY_ADDRESS=
COMPANY_GSTIN=

LOG_LEVEL=info
SESSION_TTL_HOURS=12

# Account lockout: wrong passwords in a row, and minutes locked.
# Raised while acceptance testing; set back to 5 / 15 for go-live.
LOGIN_MAX_ATTEMPTS=20
LOGIN_LOCKOUT_MINUTES=5

# Tally: mock | fail | xml | disabled; worker runs every TALLY_SYNC_INTERVAL seconds
TALLY_MODE=mock
TALLY_URL=http://tally-host:9000
TALLY_COMPANY=
TALLY_SYNC_INTERVAL=120

# Defaults only; administrators change them under Administration → Notifications
SLOW_STOCK_DAYS=30
DEAD_STOCK_DAYS=90

# ---------------------------------------------------------------------------
# Notifications (docs/operations.md). Blank = that channel runs log-only.
# The notify worker runs every NOTIFY_INTERVAL seconds.
# ---------------------------------------------------------------------------
NOTIFY_INTERVAL=60
# Public address of the app, used in e-mail links
APP_URL=
# SMTP (Gmail: smtp.gmail.com / 587 / false / your address / a 16-character app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Margix IMS <alerts@example.com>"
# WhatsApp Cloud API: permanent system-user token, phone number id, approved templates
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LOW_STOCK=
WHATSAPP_TEMPLATE_SUMMARY=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Resource caps (this host runs other applications)
APP_MEM_LIMIT=1g
DB_MEM_LIMIT=1g
