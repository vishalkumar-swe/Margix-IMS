# Postgres (see README: rootless podman container "margix-postgres")
# Runtime connection: the least-privilege app login (see docs/operations.md).
DATABASE_URL="postgresql://margix_app:change-me@127.0.0.1:15432/margix?schema=public"
# Schema owner: used only by migrations and `npm run db:grants`.
DIRECT_DATABASE_URL="postgresql://margix:margix@127.0.0.1:15432/margix?schema=public"

# Company details printed on documents (invoices, purchase orders, GRN and dispatch notes)
COMPANY_NAME="Margix India"
COMPANY_ADDRESS=""
COMPANY_GSTIN=""
# GST state code (e.g. "29"); only needed when COMPANY_GSTIN is blank. Decides CGST+SGST vs IGST.
COMPANY_STATE_CODE=""
# Bank / payment details printed on tax invoices.
COMPANY_BANK_DETAILS=""

# Log verbosity: debug | info | warn | error (JSON lines on stdout/stderr)
LOG_LEVEL=info

# Session lifetime (sliding, in hours)
SESSION_TTL_HOURS=12

# Account lockout: wrong passwords in a row, and minutes locked
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Tally client: mock | fail | xml | disabled
TALLY_MODE=mock
# For TALLY_MODE=xml: Tally Prime HTTP/XML server and the company loaded in it
TALLY_URL="http://localhost:9000"
TALLY_COMPANY=""
TALLY_TIMEOUT_MS=15000

# Days without movement before stock counts as slow / dead. These are the
# defaults; administrators can change them under Administration → Notifications.
SLOW_STOCK_DAYS=30
DEAD_STOCK_DAYS=90

# ---- Notifications (see docs/operations.md) ----
# A channel whose settings are blank runs log-only: messages are recorded as
# "skipped: not configured" and never sent. In-app notifications need nothing.
# Public address of the app, for links in e-mails
APP_URL=""
# E-mail over SMTP. Gmail: smtp.gmail.com, port 587, SMTP_SECURE=false, an app password.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# WhatsApp Cloud API (Meta): permanent access token, the sender's phone number id
# and the names of approved message templates.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_LOW_STOCK=""
WHATSAPP_TEMPLATE_SUMMARY=""
WHATSAPP_TEMPLATE_LANGUAGE=en
NOTIFY_TIMEOUT_MS=15000

# Webhooks (Administration → Integrations). Endpoints must be public https URLs
# unless private/LAN addresses are explicitly allowed.
WEBHOOK_ALLOW_PRIVATE_URLS=false
WEBHOOK_TIMEOUT_MS=10000

# Initial administrator created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@margix.local"
SEED_ADMIN_PASSWORD="change-me-now"
# Also create one demo user per role (development only)
SEED_DEMO_USERS=true
