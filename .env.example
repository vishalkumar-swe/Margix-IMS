# Postgres (see README: rootless podman container "margix-postgres")
# Runtime connection: the least-privilege app login (see docs/operations.md).
DATABASE_URL="postgresql://margix_app:change-me@127.0.0.1:15432/margix?schema=public"
# Schema owner: used only by migrations and `npm run db:grants`.
DIRECT_DATABASE_URL="postgresql://margix:margix@127.0.0.1:15432/margix?schema=public"

# Session lifetime (sliding, in hours)
SESSION_TTL_HOURS=12

# Tally client: mock | fail | xml | disabled
TALLY_MODE=mock
# For TALLY_MODE=xml: Tally Prime HTTP/XML server and the company loaded in it
TALLY_URL="http://localhost:9000"
TALLY_COMPANY=""
TALLY_TIMEOUT_MS=15000

# Reports: days without movement before stock counts as slow / dead
SLOW_STOCK_DAYS=30
DEAD_STOCK_DAYS=90

# Initial administrator created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@margix.local"
SEED_ADMIN_PASSWORD="change-me-now"
# Also create one demo user per role (development only)
SEED_DEMO_USERS=true
