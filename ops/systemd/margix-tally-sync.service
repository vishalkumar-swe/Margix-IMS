# One Tally sync pass. Triggered by margix-tally-sync.timer.
# Install (per user):  see docs/operations.md
[Unit]
Description=Margix IMS – Tally sync pass
After=network-online.target

[Service]
Type=oneshot
# Adjust to the checkout location and the Node binary directory.
WorkingDirectory=%h/apps/Margix-IMS
Environment=PATH=%h/.nvm/versions/node/v22.23.3/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run --silent tally:sync
# Exit code 2 means "some vouchers failed" — reported in the app, not a unit failure.
SuccessExitStatus=2
